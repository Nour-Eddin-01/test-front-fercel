{
  "name": "tradehub-monorepo",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts frontend",
    "build": "vite build --config frontend/vite.config.ts frontend",
    "preview": "vite preview --config frontend/vite.config.ts frontend",
    "start": "docker-compose up",
    "stop": "docker-compose down",
    "backend:shell": "docker exec -it tradehub-backend sh",
    "db:migrate": "docker exec -it tradehub-backend npx prisma migrate dev",
    "db:studio": "docker exec -it tradehub-backend npx prisma studio"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/websockets": "^11.1.16",
    "@prisma/client": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.1.11"
  }
}
