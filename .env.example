
# ==================== DATABASE (PostgreSQL) ====================
DB_USER=tradehub_user
DB_PASSWORD=your_secure_password_here
DB_NAME=tradehub_db
DB_HOST=postgres
DB_PORT=5432

# Prisma connection string
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ==================== SERVER ====================
NODE_ENV=development
PORT=3000

# ==================== JWT AUTHENTICATION ====================
# IMPORTANT: Generate a random 32+ character string for production!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_change_this
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ==================== CORS ====================
# Frontend URL
CORS_ORIGIN=http://localhost:3001

# ==================== CLOUDINARY (Image Upload) ====================
# Sign up at https://cloudinary.com for free account
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== RATE LIMITING ====================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ==================== EMAIL (Optional) ====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ==================== WEBSOCKET ====================
WS_PORT=3000

# ==================== LOGGING ====================
LOG_LEVEL=debug



# ==================== FRONTEND ====================

# ==================== API ENDPOINTS ====================
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# ==================== ENVIRONMENT ====================
VITE_ENV=development

# ==================== CLOUDINARY (Public cloud name only) ====================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ==================== FEATURES FLAGS ====================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT=true
VITE_ENABLE_NOTIFICATIONS=true

# ==================== APP CONFIG ====================
VITE_APP_NAME=TradeHub
VITE_APP_VERSION=1.0.0

# ==================== ELK ====================
KIBANA_USER=elastic
KIBANA_PASSWORD=changeme

# ==================== GRAFANA ====================
GF_USER=tradehub
GF_PASSWORD=tradehub123
